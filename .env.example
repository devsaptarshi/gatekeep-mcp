# Gateway config
GATEKEEP_DB_PATH=./data/gatekeep.sqlite
GATEKEEP_POLICY_PATH=./policies/default.yaml
GATEKEEP_LOCAL_TOKEN=change-me-to-a-random-string
# Deliberately a DIFFERENT secret from GATEKEEP_LOCAL_TOKEN — this one logs
# a human into the web approval inbox; the agent-facing token above must
# never also work there, or an agent could approve its own calls.
GATEKEEP_APPROVER_TOKEN=change-me-to-a-different-random-string

# HTTP transport (src/proxy/http-gateway.ts)
GATEKEEP_HTTP_HOST=127.0.0.1
GATEKEEP_HTTP_PORT=3100

# Upstream MCP servers are configured in gatekeep.config.yaml, not here.
# Per-upstream credentials go here as separate env vars, one per server, e.g.:
# ERP_FIXTURE_API_KEY=...

# Optional notification channel (Week 2+)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
