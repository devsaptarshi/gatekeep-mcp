# Gateway config
GATEKEEP_DB_PATH=./data/gatekeep.sqlite
GATEKEEP_POLICY_PATH=./policies/default.yaml
GATEKEEP_LOCAL_TOKEN=change-me-to-a-random-string
# Deliberately a DIFFERENT secret from GATEKEEP_LOCAL_TOKEN — this one logs
# a human into the web approval inbox; the agent-facing token above must
# never also work there, or an agent could approve its own calls.
GATEKEEP_APPROVER_TOKEN=change-me-to-a-different-random-string

# HTTP transport (src/proxy/http-gateway.ts)
GATEKEEP_HTTP_HOST=127.0.0.1
GATEKEEP_HTTP_PORT=3100

# Upstream MCP servers are configured in gatekeep.config.yaml, not here.
# Per-upstream credentials go here as separate env vars, one per server, e.g.:
# ERP_FIXTURE_API_KEY=...

# Optional: all three must be set to enable Telegram notifications + the
# inline Approve/Deny buttons (src/notify/). Get a bot token from
# @BotFather, your chat id from @userinfobot (or the getUpdates API after
# messaging your bot once). Pick any random string for the webhook secret
# — it's what proves a webhook POST actually came from Telegram, not an
# attacker who guessed your URL (Telegram echoes it back on every
# delivery; see setWebhook's secret_token).
#
# After setting these and deploying somewhere with a public HTTPS URL, run:
#   GATEKEEP_PUBLIC_URL=https://your-host npm run telegram:set-webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
